      },
      {
        "path": "CHANGELOG.md",
        "classification": "deliverable"
      },
      {
        "path": "CLAUDE.md",
        "classification": "deliverable"
      },
      {
        "path": "package.json",
        "classification": "deliverable"
      },
      {
        "path": "biome.json",
        "classification": "deliverable"
      },
      {
        "path": "tsconfig.json",
        "classification": "deliverable"
      },
      {
