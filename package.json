{
  "name": "ccmux",
  "version": "0.53.5",
  "description": "Persistent, self-healing Claude and Codex tmux sessions with deterministic resume across a fleet of machines.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ccmux": "./dist/ccmux"
  },
  "exports": {
    "./session-reader": "./src/lib.ts",
    "./monitoring-reader": "./src/monitoring-reader.ts",
    "./codex-runtime-reader": "./src/codex-runtime-reader.ts",
    "./control-client": "./src/control-client.ts",
    "./control-service-client": "./src/control-service-client.ts"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "bun run src/cli.ts",
    "tui": "bun run src/cli.ts",
    "tui:hot": "bun --hot src/cli.ts",
    "daemon:watch": "bun --watch src/cli.ts daemon",
    "smoke": "bash scripts/tui-smoke.sh",
    "check": "bun run lint && bun scripts/check-publication.ts && tsc --noEmit && bun run test && bun scripts/verify-control-service-client.ts",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "stage": "bun scripts/release.ts --stage",
    "release": "bun scripts/release.ts",
    "test": "bun test --timeout 20000",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.260",
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.43",
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opencode-ai/sdk": "1.18.27",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "ai": "7.0.92",
    "ink": "^7.1.1",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "react": "^19.2.8",
    "stitchkit": "0.80.1",
    "zod": "^4.5.4"
  },
  "packageManager": "bun@1.3.14"
}
