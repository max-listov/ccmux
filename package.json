{
  "name": "stitchmux",
  "private": true,
  "version": "0.96.2",
  "description": "Persistent, self-healing Claude and Codex tmux sessions with deterministic resume across a fleet of machines.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "stitchmux": "./dist/stitchmux"
  },
  "exports": {
    "./client": "./src/client.ts",
    "./session-reader": "./src/session-reader.ts",
    "./monitoring-reader": "./src/monitoring-reader.ts",
    "./codex-runtime-reader": "./src/codex-runtime-reader.ts",
    "./control-client": "./src/control-client.ts"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "bun run src/cli.ts",
    "tui": "bun run src/cli.ts",
    "tui:hot": "bun --hot src/cli.ts",
    "daemon:watch": "bun --watch src/cli.ts daemon",
    "smoke": "bash scripts/tui-smoke.sh",
    "check": "bun scripts/gate.ts",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "stage": "bun scripts/release.ts --stage",
    "release": "bun scripts/release.ts",
    "test": "bun scripts/test-shards.ts",
    "test:serial": "bun scripts/test-shards.ts --serial",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.332",
    "@biomejs/biome": "2.6.9",
    "@socket.io/bun-engine": "0.1.2",
    "@types/bun": "^1.4.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.3",
    "ink-testing-library": "^4.0.0",
    "socket.io": "4.8.4",
    "stitchkit": "0.133.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.96",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@opencode-ai/sdk": "1.19.6",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@stitchwire/client": "0.31.1",
    "ai": "7.0.183",
    "ink": "^8.0.0",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "stitchkit": ">=0.133.0 <1"
  },
  "packageManager": "bun@1.4.5"
}
