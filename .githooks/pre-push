#!/bin/sh
# Full local gate before code reaches the remote — the same suite CI runs
# (Biome + typecheck + tests + packed client checks).
#
# Wired via `core.hooksPath` (root `prepare` script). Bypass once with `git push --no-verify`.
set -e
# Git из GUI-редактора (Cursor, VS Code) запускает хук с голым системным PATH без профиля шелла:
# Bun там не виден. Хук добавляет его каталог сам.
PATH="$HOME/.bun/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

bun run check
